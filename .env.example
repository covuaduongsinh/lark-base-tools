# ==============================================================================
# Lark Base -> NocoEdu Web ETL Service Environment Variables
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# NocoBase 3 Integration (Docker internal network or external URL)
# If NocoBase is running in Dokploy on the same network: http://<nocobase-service-name>:13000
NOCOBASE_URL=http://nocoedu:13000
NOCOBASE_API_KEY=your_nocobase_api_key_here

# Access Security (Basic Auth for internal domain protection)
# Leave AUTH_USER and AUTH_PASS empty if relying solely on Cloudflare Zero Trust / Cloudflare Access
AUTH_USER=admin
AUTH_PASS=change_me_super_secret_password
